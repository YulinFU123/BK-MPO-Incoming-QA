            "month": {
              "range": {
                "mode": "recent6months",
                "anchor": "latestData"
              },
              "filters": [],
              "dimension": "auto",
              "metric": "quantity",
              "comparison": "previous-equivalent",
              "chart": {
                "type": "bar",
                "topN": 10,
                "sort": "value-desc",
                "labels": {
                  "mode": "all",
