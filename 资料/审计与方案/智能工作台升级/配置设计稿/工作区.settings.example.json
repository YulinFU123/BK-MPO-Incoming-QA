      "matchKeys": [
        "date",
        "process",
        "shift"
      ],
      "duplicatePolicy": "reject-conflicts",
      "measure": "production"
    },
    "statistics": {
      "rateRule": "distinct-defective-units/eligible-units",
      "rollup": "sum-numerator/sum-denominator",
