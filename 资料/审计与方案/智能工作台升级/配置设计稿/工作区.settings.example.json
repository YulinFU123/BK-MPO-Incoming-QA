                "composition",
                "details"
              ]
            },
            "week": {
              "range": {
                "mode": "recent8weeks",
                "anchor": "latestData"
              },
              "filters": [],
              "dimension": "auto",
              "metric": "quantity",
              "comparison": "previous-equivalent",
              "chart": {
                "type": "bar",
                "topN": 10,
                "sort": "value-desc",
